{
  "openapi": "3.1.0",
  "info": {
    "title": "bAI Inventory Distribution API",
    "description": "API for bAI native installers distribution, updates, staff joining, and organization onboarding.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health Check",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/releases/latest": {
      "get": {
        "tags": [
          "releases"
        ],
        "summary": "Get Latest Release",
        "description": "Retrieve the most recent published production release with its installer assets.",
        "operationId": "get_latest_release_api_releases_latest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/releases": {
      "get": {
        "tags": [
          "releases"
        ],
        "summary": "List Releases",
        "description": "List all published releases ordered from newest to oldest for the changelog.",
        "operationId": "list_releases_api_releases_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReleaseResponse"
                  },
                  "title": "Response List Releases Api Releases Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/download/{platform}/{arch}": {
      "get": {
        "tags": [
          "downloads"
        ],
        "summary": "Download Installer",
        "description": "Log an anonymized download event (without PII) and 302-redirect to the release asset URL.",
        "operationId": "download_installer_api_download__platform___arch__get",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Platform"
            }
          },
          {
            "name": "arch",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Arch"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Packaging kind: exe, msi, dmg, deb, rpm, appimage",
              "title": "Kind"
            },
            "description": "Packaging kind: exe, msi, dmg, deb, rpm, appimage"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/leads/send-link": {
      "post": {
        "tags": [
          "leads"
        ],
        "summary": "Send Download Link",
        "description": "Store mobile visitor's email lead and trigger download link delivery.\nEnforces sliding-window rate limiting and stores consent flags.",
        "operationId": "send_download_link_api_leads_send_link_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendLinkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register-business": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register Business",
        "description": "Register a new business organization and its OWNER user in a single atomic transaction.\nEnforces tenant isolation and records an OWNER_REGISTERED audit log entry.",
        "operationId": "register_business_api_auth_register_business_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterBusinessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Authenticate user credentials, verify approval status and active state,\nand return session access & refresh tokens.",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh Token",
        "description": "Exchange a valid remember token for a new access token.\nMatches fn_find_user_by_remember_token logic using SHA-256 hash lookup.",
        "operationId": "refresh_token_api_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenRefreshResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/join": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Redeem Join Code",
        "description": "Redeem an 8-character invitation join code to join an organization.\nChecks rate limits in join_attempt_rate_limits, validates expiry, role,\nupdates code as used, writes audit log, and creates staff user.",
        "operationId": "redeem_join_code_api_auth_join_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/organizations/{org_id}/join-codes": {
      "post": {
        "tags": [
          "organizations"
        ],
        "summary": "Create Join Code",
        "description": "Generate a 10-minute invitation join code for staff onboarding.\nRequires OWNER / ADMIN role and enforces tenant boundary isolation.",
        "operationId": "create_join_code_api_organizations__org_id__join_codes_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Org Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJoinCodeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinCodeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/updates/check": {
      "get": {
        "tags": [
          "updates"
        ],
        "summary": "Check For Updates",
        "description": "Check for software updates against the latest published production release.\nUsed by the JavaFX client auto-updater.",
        "operationId": "check_for_updates_api_updates_check_get",
        "parameters": [
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Currently installed client version, e.g. 1.0.0",
              "title": "Version"
            },
            "description": "Currently installed client version, e.g. 1.0.0"
          },
          {
            "name": "platform",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Operating system: windows, macos, linux",
              "title": "Platform"
            },
            "description": "Operating system: windows, macos, linux"
          },
          {
            "name": "arch",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Architecture: x64, arm64",
              "title": "Arch"
            },
            "description": "Architecture: x64, arm64"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateCheckResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/releases": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Publish Or Update Release",
        "description": "CI / Automation endpoint: registers a new application release and attaches\ninstaller assets with pre-calculated SHA-256 checksums and file sizes.\nProtected by X-API-Key or Bearer token header.",
        "operationId": "publish_or_update_release_api_admin_releases_post",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReleaseRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refresh Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "organization": {
            "$ref": "#/components/schemas/OrgResponse"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "user",
          "organization"
        ],
        "title": "AuthResponse"
      },
      "CreateJoinCodeRequest": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "EMPLOYEE",
              "MANAGER"
            ],
            "title": "Role",
            "description": "Role to assign upon redemption",
            "default": "EMPLOYEE"
          }
        },
        "type": "object",
        "title": "CreateJoinCodeRequest"
      },
      "CreateReleaseAssetSchema": {
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "windows",
              "macos",
              "linux"
            ],
            "title": "Platform"
          },
          "arch": {
            "type": "string",
            "enum": [
              "x64",
              "arm64"
            ],
            "title": "Arch"
          },
          "kind": {
            "type": "string",
            "enum": [
              "exe",
              "msi",
              "dmg",
              "deb",
              "rpm",
              "appimage"
            ],
            "title": "Kind"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "download_url": {
            "type": "string",
            "title": "Download Url"
          },
          "sha256": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Sha256",
            "description": "Hexadecimal SHA-256 checksum"
          },
          "size_bytes": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Size Bytes"
          }
        },
        "type": "object",
        "required": [
          "platform",
          "arch",
          "kind",
          "file_name",
          "download_url",
          "sha256",
          "size_bytes"
        ],
        "title": "CreateReleaseAssetSchema"
      },
      "CreateReleaseRequest": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version",
            "description": "Semantic version, e.g. 1.0.0"
          },
          "tag_name": {
            "type": "string",
            "title": "Tag Name",
            "description": "Git tag, e.g. v1.0.0"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Human-readable release title"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes",
            "description": "Markdown changelog notes"
          },
          "is_prerelease": {
            "type": "boolean",
            "title": "Is Prerelease",
            "default": false
          },
          "is_published": {
            "type": "boolean",
            "title": "Is Published",
            "default": true
          },
          "assets": {
            "items": {
              "$ref": "#/components/schemas/CreateReleaseAssetSchema"
            },
            "type": "array",
            "title": "Assets",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "version",
          "tag_name",
          "name"
        ],
        "title": "CreateReleaseRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JoinCodeResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "organization_id": {
            "type": "integer",
            "title": "Organization Id"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "organization_id",
          "code",
          "role",
          "expires_at",
          "created_at"
        ],
        "title": "JoinCodeResponse"
      },
      "JoinRequest": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "8-character invite code, e.g. G87M-6MZK"
          },
          "full_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Full Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "full_name",
          "email",
          "password"
        ],
        "title": "JoinRequest"
      },
      "LeadResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "success": {
            "type": "boolean",
            "title": "Success",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "message",
          "email"
        ],
        "title": "LeadResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "remember_me": {
            "type": "boolean",
            "title": "Remember Me",
            "default": false
          },
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "OrgResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Slug"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "is_active",
          "created_at"
        ],
        "title": "OrgResponse"
      },
      "RefreshTokenRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshTokenRequest"
      },
      "RegisterBusinessRequest": {
        "properties": {
          "business_name": {
            "type": "string",
            "maxLength": 150,
            "minLength": 2,
            "title": "Business Name",
            "description": "Business or store name"
          },
          "full_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Full Name",
            "description": "Owner full name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "Business owner email address"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "description": "Password (at least 8 characters)"
          }
        },
        "type": "object",
        "required": [
          "business_name",
          "full_name",
          "email",
          "password"
        ],
        "title": "RegisterBusinessRequest"
      },
      "ReleaseAssetResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "arch": {
            "type": "string",
            "title": "Arch"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "download_url": {
            "type": "string",

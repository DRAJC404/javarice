# Database Configuration
POSTGRES_DB=bai_pos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bai_pos

# API Security & Secrets
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
ADMIN_API_KEY=bai-admin-release-ci-key-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS & Web Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

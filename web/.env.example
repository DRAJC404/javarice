# bAI Web Environment Configuration

# Base URL for static installer assets (defaults to /downloads for local testing)
# To point to GitHub Releases in production, set:
# NEXT_PUBLIC_RELEASES_BASE=https://github.com/bai-inventory/bai/releases/download/v1.0.0
NEXT_PUBLIC_RELEASES_BASE=/downloads

# Backend API URL (for client-side browser requests)
NEXT_PUBLIC_API_URL=http://localhost:8000
